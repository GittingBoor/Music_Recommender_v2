# Vorlage fuer .env.prod auf dem Mini-PC. Die echte Datei gehoert NICHT ins Git.
# Kopieren:  cp .env.prod.example .env.prod   und ausfuellen.

# --- Datenbank ---------------------------------------------------------------
POSTGRES_USER=musicrec
# Neu erzeugen, nicht das Entwicklungspasswort nehmen:
#   openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=music_recommender

# Wird vom Backend-Container gelesen (SQLAlchemy). Muss zu den Werten oben passen.
DATABASE_URL=postgresql://musicrec:<passwort>@db:5432/music_recommender

# --- Ablage der Daten auf dem Mini-PC ----------------------------------------
# Darunter liegen postgres/, datasets/, model_cache/, short_audio/, backup/
DATA_DIR=/srv/music-recommender

# --- Cloudflare Tunnel -------------------------------------------------------
# Zero Trust -> Networks -> Tunnels -> Tunnel anlegen -> Token kopieren
TUNNEL_TOKEN=

# --- API-Keys (wie in backend/.env) ------------------------------------------
LASTFM_API_KEY=
ACOUSTID_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
